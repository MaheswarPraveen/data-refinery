{
  "_note": "Phone agent tools. risk: none = runs freely, confirm = ask Yes/No first, phrase = needs the 12-word unlock, blocked = never via the agent.",
  "tools": [
    {"name": "get_status", "args": {}, "risk": "none", "desc": "battery, temperature, CPU, RAM, storage, network, foreground app"},
    {"name": "set_cpu_mode", "args": {"mode": "powersave|balanced|performance"}, "risk": "none", "desc": "CPU/GPU performance profile within safe limits"},
    {"name": "set_brightness", "args": {"level": "0-100"}, "risk": "none", "desc": "screen brightness"},
    {"name": "toggle", "args": {"target": "wifi|data|bluetooth|location|flashlight|dnd|battery_saver", "state": "on|off"}, "risk": "none", "desc": "switch a phone feature"},
    {"name": "set_volume", "args": {"stream": "media|ring|alarm|notification", "level": "0-100"}, "risk": "none", "desc": "volume"},
    {"name": "screen", "args": {"action": "off|lock|timeout", "seconds": "number, only for timeout"}, "risk": "none", "desc": "screen control"},
    {"name": "power", "args": {"action": "reboot|shutdown"}, "risk": "confirm", "desc": "restart or turn off the phone"},
    {"name": "open_app", "args": {"name": "app name"}, "risk": "none", "desc": "open an app"},
    {"name": "close_app", "args": {"name": "app name"}, "risk": "none", "desc": "force-close an app"},
    {"name": "list_apps", "args": {"which": "running|installed"}, "risk": "none", "desc": "list apps"},
    {"name": "install_app", "args": {"source": "apk path or store name"}, "risk": "confirm", "desc": "install an app"},
    {"name": "uninstall_app", "args": {"name": "app name"}, "risk": "confirm", "desc": "remove an app"},
    {"name": "read_screen", "args": {}, "risk": "none", "desc": "text and buttons currently on screen"},
    {"name": "tap", "args": {"target": "visible text or element id"}, "risk": "none", "desc": "tap an element in the current app"},
    {"name": "type_text", "args": {"text": "text"}, "risk": "none", "desc": "type into the focused field"},
    {"name": "navigate", "args": {"action": "back|home|recents|scroll_up|scroll_down"}, "risk": "none", "desc": "system navigation"},
    {"name": "read_notifications", "args": {}, "risk": "none", "desc": "current notifications"},
    {"name": "send_message", "args": {"app": "sms|whatsapp|telegram", "contact": "name", "text": "message"}, "risk": "confirm", "desc": "send a message"},
    {"name": "call", "args": {"contact": "name or number"}, "risk": "confirm", "desc": "place a phone call"},
    {"name": "set_alarm", "args": {"time": "HH:MM", "label": "text"}, "risk": "none", "desc": "alarm"},
    {"name": "set_reminder", "args": {"time": "ISO time or relative", "text": "what to remind"}, "risk": "none", "desc": "reminder"},
    {"name": "add_calendar", "args": {"title": "text", "start": "ISO time", "duration_min": "number"}, "risk": "none", "desc": "calendar event"},
    {"name": "web_search", "args": {"query": "text"}, "risk": "none", "desc": "search the web"},
    {"name": "fetch_page", "args": {"url": "https URL"}, "risk": "none", "desc": "read a web page as text"},
    {"name": "browser", "args": {"action": "open|click|type|read|submit", "target": "url, element text or field", "text": "only for type"}, "risk": "none", "desc": "drive the built-in browser; submit needs confirm"},
    {"name": "read_file", "args": {"path": "path"}, "risk": "none", "desc": "read a file"},
    {"name": "list_dir", "args": {"path": "path"}, "risk": "none", "desc": "list a folder"},
    {"name": "write_file", "args": {"path": "path", "content": "text"}, "risk": "confirm", "desc": "create or overwrite a file"},
    {"name": "delete_file", "args": {"path": "path"}, "risk": "confirm", "desc": "delete a file; folders or system paths need phrase"},
    {"name": "run_shell", "args": {"cmd": "shell command"}, "risk": "auto", "desc": "root shell; read-only = none, changes = confirm, dangerous (rm -rf, dd, mkfs, /system writes) = phrase, bootloader or partition erase = blocked"},
    {"name": "write_script", "args": {"name": "file name", "lang": "sh|python", "code": "code"}, "risk": "confirm", "desc": "write and run a script"},
    {"name": "remember", "args": {"fact": "text"}, "risk": "none", "desc": "save to long-term memory"},
    {"name": "recall", "args": {"query": "text"}, "risk": "none", "desc": "search memory"},
    {"name": "forget", "args": {"fact": "text"}, "risk": "confirm", "desc": "delete from memory"},
    {"name": "ask_user", "args": {"question": "text"}, "risk": "none", "desc": "ask when the request is unclear"},
    {"name": "say", "args": {"text": "reply"}, "risk": "none", "desc": "spoken/text reply; use when no tool is needed"},
    {"name": "handoff_gemini", "args": {"task": "text"}, "risk": "none", "desc": "hand a complex task to Gemini; only when the user's switch is on and online"}
  ]
}
